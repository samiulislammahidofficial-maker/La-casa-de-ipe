rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isOrganizer() {
      return isSignedIn() && getUserData().role == 'organizer';
    }

    function isStudent() {
      return isSignedIn() && (getUserData().role == 'student' || !('role' in getUserData()));
    }

    // Users Collection
    match /users/{userId} {
      
      function isValidUser(data) {
        return data.keys().hasAll(['name', 'email', 'role']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 150 &&
               data.role in ['student', 'organizer', 'admin'];
      }

      function isValidUserUpdate(incoming, existing) {
         // Users cannot elevate their own role unless they are admin.
         return incoming.diff(existing).affectedKeys().hasAny(['role']) == false;
      }

      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && 
                       isValidUser(request.resource.data) && 
                       request.resource.data.role == 'student'; // Force student role on create via client

      // Admins can update roles
      allow update: if isSignedIn() && isValidId(userId) && 
                       isValidUser(request.resource.data) &&
                       (
                         isAdmin() || 
                         (request.auth.uid == userId && isValidUserUpdate(request.resource.data, resource.data))
                       );
      
      allow delete: if isAdmin();
    }

    // Registrations Collection
    match /registrations/{registrationId} {
      
      function isValidRegistration(data) {
        return data.keys().hasAll(['userId', 'eventName', 'createdAt']) &&
               data.userId is string && data.userId.size() <= 128 &&
               data.eventName is string && data.eventName.size() > 0 && data.eventName.size() <= 100;
      }

      allow get: if isSignedIn() && isValidId(registrationId) && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        (isOrganizer() && resource.data.eventName == getUserData().assignedEvent)
      );
      
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        (isOrganizer() && resource.data.eventName == getUserData().assignedEvent)
      );

      allow create: if isSignedIn() && isValidId(registrationId) && 
                       isValidRegistration(request.resource.data) && 
                       request.resource.data.userId == request.auth.uid &&
                       exists(/databases/$(database)/documents/users/$(request.auth.uid));

      // No updating registrations typical for users, only admin
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
